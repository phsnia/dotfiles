# Credentials for git's `store` helper. Copy to .env (gitignored), mode 600:
#
#   cp .env.example .env && chmod 600 .env
#
# One line per host, in `store` format — scheme://username:token@host
# Prefer letting git write it (keeps the token out of your shell history):
#
#   printf 'protocol=https\nhost=github.com\nusername=phsnia\npassword=ghp_xxx\n\n' \
#     | git credential approve
#
# Use a fine-grained GitHub token with "Contents: read and write".
https://phsnia:ghp_PASTE_TOKEN_HERE@github.com
